rules_version = '2';

// Everything public is pseudonymous: pins hold team + blurred coords; tribes hold a city centre;
// members and posts carry a self-chosen nickname, never a name or email.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.uid; }
    // paths are built segment by segment ($() escapes slashes, so 'a/b' would be one segment)
    function pinDoc(u) { return /databases/$(database)/documents/pins/$(u); }
    function presenceDoc(u) { return /databases/$(database)/documents/presence/$(u); }
    function userDoc(u) { return /databases/$(database)/documents/users/$(u); }
    function tribe(t) { return /databases/$(database)/documents/tribes/$(t); }
    function member(t, u) { return /databases/$(database)/documents/tribes/$(t)/members/$(u); }
    function post(t, p) { return /databases/$(database)/documents/tribes/$(t)/posts/$(p); }
    function reportDoc(t, p, u) { return /databases/$(database)/documents/tribes/$(t)/posts/$(p)/reports/$(u); }
    // a guest counts as a member until their end date
    function isMember(t) { return exists(member(t, me())) && (get(member(t, me())).data.role != 'guest' || get(member(t, me())).data.until > request.time); }
    // posts and replies carry guest: true exactly when the author is a guest
    function guestFlagOk(t) { return ('guest' in request.resource.data) == (get(member(t, me())).data.role == 'guest') && (!('guest' in request.resource.data) || request.resource.data.guest == true); }
    function isCaptain(t) { return isMember(t) && get(member(t, me())).data.role in ['captain', 'cocaptain']; }
    // the founding captain, alone in the tribe: may clear its feed before leaving, which deletes the tribe
    function lastCaptain(t) { return isMember(t) && get(member(t, me())).data.role == 'captain' && get(tribe(t)).data.memberCount == 1; }
    // a guest whose 3 days are over: anyone may sweep them out, so memberCount stays honest
    function expiredGuest(t, u) { return exists(member(t, u)) && get(member(t, u)).data.role == 'guest' && get(member(t, u)).data.until <= request.time; }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function text(s, max) { return s is string && s.trim().size() > 0 && s.size() <= max; }

    // BEGIN profanity (generated by npm run sync:profanity from web/src/profanity.js – do not edit by hand)
    function fold(s) {
      return s.lower().replace('0', 'o').replace('[1!|]', 'i').replace('3', 'e').replace('[4@]', 'a').replace('[5$]', 's').replace('7', 't')
        .replace('[áàâäãÁÀÂÄÃ]', 'a').replace('[éèêëÉÈÊË]', 'e').replace('[íìîïÍÌÎÏ]', 'i').replace('[óòôöőõÓÒÔÖŐÕ]', 'o')
        .replace('[úùûüűÚÙÛÜŰ]', 'u').replace('[ñÑ]', 'n').replace('[çÇ]', 'c');
    }
    function badText(s) {
      let f = fold(s);
      return f.matches('(?s)(.*[^a-z])?(fasz|geci|kurv|picsa|punci|buzi|kocsog|segg|ribanc|kibasz|elbasz|megbasz|lebasz|baszd|baszom|baszott|baszni|baszik|baszas|baszol|basztam|bazdmeg|bazmeg|baszki|szopd|szopj|szopas|faszkalap|fuck|fuq|phuck|shit|cunt|bitch|biatch|nigg|whore|slut|asshole|arsehole|motherf|retard|faggot|rapist|wanker|wanking|dickhead|bollock|bullshit|jackass|dumbass|douchebag|twat|tranny|puta|mierd|cabron|gilipoll|pendej|maricon|joder|jodid|culero|capull|cojon|hijoputa|hijueputa|follar|follando|chingar|chingad|pinche|huevon|conazo|mamon|sudaca|malparid|hitler|siegheil).*')
        || f.matches('(?s)(.*[^a-z])?(szar|fos|cici|csocs|basz|bassz|dick|cock|prick|pussy|fag|piss|wtf|stfu|kys|kkk|coon|spic|kike|chink|paki|verga|polla|culo|hdp|ptm|chinga|nazi|nazik|nazis|nazist|naci|nacis|sieg heil)([^a-z].*)?');
    }
    function badName(s) {
      return fold(s).replace('[_-]', '').matches('.*(fasz|geci|kurv|picsa|punci|buzi|kocsog|segg|ribanc|kibasz|elbasz|megbasz|lebasz|baszd|baszom|baszott|baszni|baszik|baszas|baszol|basztam|bazdmeg|bazmeg|baszki|szopd|szopj|szopas|faszkalap|fuck|fuq|phuck|shit|cunt|bitch|biatch|nigg|whore|slut|asshole|arsehole|motherf|retard|faggot|rapist|wanker|wanking|dickhead|bollock|bullshit|jackass|dumbass|douchebag|twat|tranny|puta|mierd|cabron|gilipoll|pendej|maricon|joder|jodid|culero|capull|cojon|hijoputa|hijueputa|follar|follando|chingar|chingad|pinche|huevon|conazo|mamon|sudaca|malparid|hitler|siegheil).*');
    }
    // END profanity
    function cleanText(s, max) { return text(s, max) && !badText(s); }
    // username: 3–20 chars, English letters, digits, - and _; unique via usernames/{lowercase}
    function validNick(n) { return n is string && n.matches('^[A-Za-z0-9_-]{3,20}$') && !badName(n); }
    function usernameDoc(n) { return /databases/$(database)/documents/usernames/$(n); }
    // every post / reply / reply-count bump must be batched with this rate-limited stamp
    function stampedNow(t) { return getAfter(member(t, me())).data.lastPostAt == request.time; }

    // ~50 km box around a tribe's city centre (rules have no trig, so the longitude span widens by latitude band)
    function close(aLat, aLng, bLat, bLng) {
      let dLat = math.abs(aLat - bLat);
      let dLng = math.abs(aLng - bLng);
      let absLat = math.abs(bLat);
      let lim = absLat < 35 ? 0.55 : (absLat < 50 ? 0.7 : (absLat < 60 ? 0.9 : 1.3));
      return dLat <= 0.45 && (dLng <= lim || dLng >= 360 - lim);
    }
    // "you are near": your own pin (home), or a fresh "I'm here now" check-in (travelling, valid 72 h)
    function nearMe(lat, lng) {
      let pinPath = pinDoc(me());
      let herePath = presenceDoc(me());
      return (exists(pinPath) && close(get(pinPath).data.lat, get(pinPath).data.lng, lat, lng))
        || (exists(herePath) && request.time < get(herePath).data.ts + duration.value(72, 'h')
          && close(get(herePath).data.lat, get(herePath).data.lng, lat, lng));
    }

    // ---------- pins/{uid}: one pin per account ----------
    function validPin(d) {
      return d.keys().hasOnly(['t', 'lat', 'lng', 'p', 'ts'])
        && d.keys().hasAll(['t', 'lat', 'lng', 'p', 'ts'])
        && cleanText(d.t, 40)
        && d.lat is number && d.lat >= -85 && d.lat <= 85
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.p in ['area', 'city', 'exact']
        && d.ts == request.time;
    }
    match /pins/{uid} {
      allow read: if true;
      allow create: if signedIn() && me() == uid && validPin(request.resource.data);
      // at most one change every 30 s per account
      allow update: if signedIn() && me() == uid && validPin(request.resource.data)
        && request.time > resource.data.ts + duration.value(30, 's');
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- presence/{uid}: private "I'm here now" check-in, city-level (0.05° grid) ----------
    match /presence/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'ts'])
        && request.resource.data.lat is number && request.resource.data.lat >= -85 && request.resource.data.lat <= 85
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        && request.resource.data.ts == request.time;
    }

    // ---------- users/{uid}: private profile (username + when the community rules were accepted) ----------
    match /users/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['nick', 'rulesAt'])
        && validNick(request.resource.data.nick)
        && (!('rulesAt' in request.resource.data) || request.resource.data.rulesAt is timestamp)
        // the name must be claimed by me in the same batch (or already), and not hidden by reports
        && getAfter(usernameDoc(request.resource.data.nick.lower())).data.uid == me()
        && getAfter(usernameDoc(request.resource.data.nick.lower())).data.get('reports', 0) < 3;
    }

    // ---------- stats/{uid}: public XP + membership ledger ----------
    // xp: +10 once per UTC day, +50 the first time you join (or found) a given tribe, +100 to the
    // inviter when someone joins a tribe for the first time through their link.
    // teams: {team: number of my current tribes of that team} – at most 3 teams.
    // current: my tribe ids now; joined: every tribe id I ever joined (no XP farming by leave + rejoin).
    function statsDoc(u) { return /databases/$(database)/documents/stats/$(u); }
    function dailyClaim() {
      return changedOnly(['xp', 'lastDailyAt'])
        && request.resource.data.xp == resource.data.xp + 10
        && request.resource.data.lastDailyAt == request.time
        && request.time.date() > resource.data.lastDailyAt.date();
    }
    // guards first: a ledger without lastJoin / lastLeave (backfilled by hand, or never joined) would make the
    // let-bindings below an evaluation error, and an error anywhere in the update's || chain refuses the write
    function joinLedger() { return 'lastJoin' in request.resource.data && joinLedgerOk(); }
    function leaveLedger() { return 'lastLeave' in request.resource.data && leaveLedgerOk(); }
    function joinLedgerOk() {
      let b = resource.data;
      let a = request.resource.data;
      let tid = a.lastJoin;
      let team = getAfter(tribe(tid)).data.team;
      let first = !(tid in b.joined);
      return changedOnly(['xp', 'teams', 'joined', 'current', 'lastJoin'])
        && !exists(member(tid, me())) && existsAfter(member(tid, me()))
        && !(tid in b.current) && a.current == b.current.concat([tid])
        && a.teams.get(team, 0) == b.teams.get(team, 0) + 1
        && a.teams.diff(b.teams).affectedKeys().hasOnly([team])
        && a.teams.size() <= 3
        && a.joined == (first ? b.joined.concat([tid]) : b.joined)
        && a.xp == b.xp + (first ? 50 : 0);
    }
    function leaveLedgerOk() {
      let b = resource.data;
      let a = request.resource.data;
      let tid = a.lastLeave;
      let team = get(tribe(tid)).data.team;
      let had = tid in b.current;
      let n = b.teams.get(team, 0);
      return changedOnly(['teams', 'current', 'lastLeave'])
        && exists(member(tid, me())) && !existsAfter(member(tid, me()))
        && a.current == b.current.removeAll([tid])
        && (!had || n < 1 ? a.teams == b.teams
          : (n == 1 ? !(team in a.teams) : a.teams.get(team, 0) == n - 1)
            && a.teams.diff(b.teams).affectedKeys().hasOnly([team]));
    }
    // written by the joiner onto the inviter's stats, in the same batch as the join
    function referralCredit(uid) {
      let mine = statsDoc(me());
      let tid = getAfter(mine).data.lastJoin;
      return uid != me() && changedOnly(['xp', 'refs'])
        && request.resource.data.xp == resource.data.xp + 100
        && request.resource.data.refs == resource.data.refs + 1
        && !exists(member(tid, me())) && existsAfter(member(tid, me()))
        && getAfter(member(tid, me())).data.ref == uid
        && !(tid in get(mine).data.joined);
    }
    match /stats/{uid} {
      allow read: if true;
      // created by the first daily claim
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['xp', 'lastDailyAt', 'refs', 'teams', 'joined', 'current'])
        && request.resource.data.xp == 10 && request.resource.data.lastDailyAt == request.time
        && request.resource.data.refs == 0 && request.resource.data.teams == {}
        && request.resource.data.joined == [] && request.resource.data.current == [];
      allow update: if signedIn() && (
        (me() == uid && (dailyClaim() || joinLedger() || leaveLedger() || cheerClaim()))
        || referralCredit(uid)
      );
      // account deletion (GDPR): my ledger goes with me
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- match days: cheers/{fixtureId_uid} + matches/{fixtureId} counters ----------
    // The fixture list lives outside Firestore (GitHub Pages JSON), so the rules cannot check that the
    // match is real or today; they do guarantee one cheer per account per match, counters that move
    // only with a cheer, the cheerer's own pin team and position, and +25 XP at most once per UTC day.
    function cheerDoc(id) { return /databases/$(database)/documents/cheers/$(id); }
    function matchDoc(f) { return /databases/$(database)/documents/matches/$(f); }
    function cheerClaim() {
      let b = resource.data;
      let a = request.resource.data;
      return changedOnly(['xp', 'lastCheerAt', 'lastCheer'])
        && a.xp == b.xp + 25
        && a.lastCheerAt == request.time
        && (!('lastCheerAt' in b) || request.time.date() > b.lastCheerAt.date())
        && a.lastCheer is string && a.lastCheer.matches('^[0-9]{1,12}_' + me() + '$')
        && !exists(cheerDoc(a.lastCheer)) && existsAfter(cheerDoc(a.lastCheer));
    }
    match /cheers/{cid} {
      allow read: if true;
      allow create: if signedIn()
        && cid == string(request.resource.data.f) + '_' + me()
        && request.resource.data.keys().hasOnly(['f', 'u', 'side', 'team', 'lat', 'lng', 'ts'])
        // u: my uid, so my cheers can be found and erased when I delete my account
        && request.resource.data.u == me()
        && request.resource.data.f is int && request.resource.data.f > 0
        && request.resource.data.side in ['h', 'a']
        && exists(pinDoc(me()))
        && request.resource.data.team == get(pinDoc(me())).data.t
        && request.resource.data.lat == get(pinDoc(me())).data.lat
        && request.resource.data.lng == get(pinDoc(me())).data.lng
        && request.resource.data.ts == request.time
        // the counter of my side goes up by one in the same batch
        && getAfter(matchDoc(request.resource.data.f)).data.get(request.resource.data.side, 0)
          == (exists(matchDoc(request.resource.data.f)) ? get(matchDoc(request.resource.data.f)).data.get(request.resource.data.side, 0) : 0) + 1;
      allow update: if false;
      // account deletion (GDPR): my cheers go; the match counters stay as anonymous totals
      allow delete: if signedIn() && resource.data.u == me();
    }
    match /matches/{f} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['h', 'a'])
        && request.resource.data.size() == 1
        && request.resource.data.get('h', 1) == 1 && request.resource.data.get('a', 1) == 1
        && !exists(cheerDoc(f + '_' + me())) && existsAfter(cheerDoc(f + '_' + me()));
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['h', 'a'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && !exists(cheerDoc(f + '_' + me())) && existsAfter(cheerDoc(f + '_' + me()))
        && request.resource.data.get(getAfter(cheerDoc(f + '_' + me())).data.side, 0)
          == resource.data.get(getAfter(cheerDoc(f + '_' + me())).data.side, 0) + 1;
      allow delete: if false;
    }

    // ---------- usernames/{lowercase}: uniqueness claims ----------
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me()
        && name.matches('^[a-z0-9_-]{3,20}$')
        && getAfter(userDoc(me())).data.nick.lower() == name;
      // reporting a name: +1, together with my one-per-name report doc; never my own name
      allow update: if signedIn() && resource.data.uid != me()
        && changedOnly(['reports'])
        && request.resource.data.reports == resource.data.get('reports', 0) + 1
        && !exists(nameReportDoc(name, me())) && existsAfter(nameReportDoc(name, me()));
      // release only my own claim, only when my profile no longer uses it, and never a reported-away name
      // (a hidden name stays reserved, so nobody can pick it up again)
      allow delete: if signedIn() && resource.data.uid == me()
        && resource.data.get('reports', 0) < 3
        && (!existsAfter(userDoc(me())) || getAfter(userDoc(me())).data.nick.lower() != name);

      match /reports/{uid} {
        allow read: if false;
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time
          && getAfter(usernameDoc(name)).data.reports == get(usernameDoc(name)).data.get('reports', 0) + 1;
      }
    }
    function nameReportDoc(n, u) { return /databases/$(database)/documents/usernames/$(n)/reports/$(u); }
    // posting needs a name that is not hidden by reports (legacy names without a claim are let through)
    function nameOk(n) { return !exists(usernameDoc(n.lower())) || get(usernameDoc(n.lower())).data.get('reports', 0) < 3; }

    // ---------- tribes/{tid}: one per team + city; id = <cityOsm>_<team slug> ----------
    match /tribes/{tid} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['team', 'name', 'city', 'district', 'cityOsm', 'country', 'lat', 'lng', 'memberCount', 'createdAt', 'lastActivityAt'])
        && text(request.resource.data.team, 40)
        // optional custom name; the team is still shown next to it as a tag
        && (!('name' in request.resource.data) || (cleanText(request.resource.data.name, 40) && request.resource.data.name.trim().size() >= 3))
        && text(request.resource.data.city, 80)
        // optional district / neighbourhood of a big city; then cityOsm (and so the id) is the district's OSM id
        && (!('district' in request.resource.data) || text(request.resource.data.district, 80))
        && request.resource.data.country is string && request.resource.data.country.size() <= 80
        && request.resource.data.cityOsm.matches('^[NWR][0-9]{1,12}$')
        && tid == request.resource.data.cityOsm + '_' + request.resource.data.team.lower().replace('[^a-z0-9]+', '-')
        && request.resource.data.lat is number && request.resource.data.lat >= -85 && request.resource.data.lat <= 85
        && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        // only for the team on your own pin, and only where you are
        && exists(pinDoc(me()))
        && get(pinDoc(me())).data.t == request.resource.data.team
        && nearMe(request.resource.data.lat, request.resource.data.lng)
        && request.resource.data.memberCount == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && getAfter(member(tid, me())).data.role == 'captain';

      allow update: if signedIn() && (
        // join: +1, my member doc appears in the same batch
        (changedOnly(['memberCount', 'lastActivityAt'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && request.resource.data.lastActivityAt == request.time
          && !exists(member(tid, me())) && existsAfter(member(tid, me())))
        // leave: -1, my member doc disappears in the same batch
        || (changedOnly(['memberCount'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && exists(member(tid, me())) && !existsAfter(member(tid, me())))
        // sweep: -1, an expired guest's member doc (named in swept) disappears in the same batch
        || (changedOnly(['memberCount', 'swept'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && request.resource.data.swept is string && expiredGuest(tid, request.resource.data.swept)
          && !existsAfter(member(tid, request.resource.data.swept)))
        // activity stamp from a member who just posted
        || (changedOnly(['lastActivityAt']) && request.resource.data.lastActivityAt == request.time
          && isMember(tid) && stampedNow(tid))
      );
      // the last member (always the captain: a leaving captain hands over first) leaves, the tribe goes with them
      allow delete: if signedIn() && resource.data.memberCount == 1
        && exists(member(tid, me())) && get(member(tid, me())).data.role == 'captain'
        && !existsAfter(member(tid, me()));

      match /members/{uid} {
        allow read: if true;
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['nick', 'role', 'joinedAt', 'ref', 'until'])
          && exists(userDoc(uid)) && ('rulesAt' in get(userDoc(uid)).data)
          && request.resource.data.nick == get(userDoc(uid)).data.nick
          && request.resource.data.joinedAt == request.time
          // who invited me (their uid from the invite link); never myself
          && (!('ref' in request.resource.data) || (request.resource.data.ref is string && request.resource.data.ref != uid))
          // only a guest has (and must have) an end date
          && ((request.resource.data.role == 'guest') == ('until' in request.resource.data))
          && (
            // the membership ledger (3-team limit, XP) must be updated in the same batch
            (getAfter(statsDoc(uid)).data.lastJoin == tid && (
              // founding captain: the tribe doc is created in the same batch
              (request.resource.data.role == 'captain' && !exists(tribe(tid)) && existsAfter(tribe(tid)))
              // regular member: must be near the tribe; the tribe's count goes up by one in the same batch
              || (request.resource.data.role == 'member' && exists(tribe(tid))
                && nearMe(get(tribe(tid)).data.lat, get(tribe(tid)).data.lng)
                && getAfter(tribe(tid)).data.memberCount == get(tribe(tid)).data.memberCount + 1)
            ))
            // guest: from anywhere, for at most 3 days (72 h + 1 h clock skew); no ledger, no XP, no team slot
            || (request.resource.data.role == 'guest' && exists(tribe(tid)) && !('ref' in request.resource.data)
              && request.resource.data.until is timestamp && request.resource.data.until > request.time
              && request.resource.data.until <= request.time + duration.value(73, 'h')
              && getAfter(tribe(tid)).data.memberCount == get(tribe(tid)).data.memberCount + 1)
          );
        // rate limit: at most one post / reply every 20 s; or follow my renamed username
        allow update: if signedIn() && ((me() == uid && (
          (changedOnly(['lastPostAt'])
            && request.resource.data.lastPostAt == request.time
            && (!('lastPostAt' in resource.data) || request.time > resource.data.lastPostAt + duration.value(20, 's')))
          || (changedOnly(['nick']) && request.resource.data.nick == getAfter(userDoc(uid)).data.nick)
        ))
          // a leaving captain hands the captaincy to another member in the same batch
          || (me() != uid && changedOnly(['role']) && request.resource.data.role == 'captain'
            && exists(member(tid, me())) && get(member(tid, me())).data.role == 'captain'
            && !existsAfter(member(tid, me())))
        );
        // the tribe's count goes down by one, or the tribe itself goes (last member)
        allow delete: if signedIn() && ((me() == uid
          && (!existsAfter(tribe(tid)) || getAfter(tribe(tid)).data.memberCount == get(tribe(tid)).data.memberCount - 1)
          && (!exists(statsDoc(uid)) || getAfter(statsDoc(uid)).data.lastLeave == tid))
          // anyone sweeps out an expired guest, the tribe naming them in swept and counting one less
          || (me() != uid && resource.data.role == 'guest' && resource.data.until <= request.time
            && getAfter(tribe(tid)).data.swept == uid
            && getAfter(tribe(tid)).data.memberCount == get(tribe(tid)).data.memberCount - 1));
      }

      match /posts/{pid} {
        allow read: if true;
        allow create: if signedIn() && isMember(tid) && stampedNow(tid) && nameOk(get(member(tid, me())).data.nick)
          && request.resource.data.keys().hasOnly(['authorUid', 'nick', 'type', 'text', 'createdAt', 'replyCount', 'reportCount', 'hidden', 'guest']) && guestFlagOk(tid)
          && request.resource.data.authorUid == me()
          && request.resource.data.nick == get(member(tid, me())).data.nick
          && request.resource.data.type == 'text'
          && cleanText(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time
          && request.resource.data.replyCount == 0
          && request.resource.data.reportCount == 0
          && request.resource.data.hidden == false;
        allow update: if signedIn() && (
          (changedOnly(['replyCount']) && request.resource.data.replyCount == resource.data.replyCount + 1
            && isMember(tid) && stampedNow(tid))
          || (changedOnly(['reportCount']) && request.resource.data.reportCount == resource.data.reportCount + 1
            && !exists(reportDoc(tid, pid, me()))
            && existsAfter(reportDoc(tid, pid, me())))
          || (changedOnly(['hidden']) && request.resource.data.hidden is bool && isCaptain(tid))
        );
        allow delete: if signedIn() && (resource.data.authorUid == me() || lastCaptain(tid));

        match /reports/{uid} {
          allow read: if false;
          allow create: if signedIn() && me() == uid
            && request.resource.data.keys().hasOnly(['reason', 'createdAt'])
            && request.resource.data.reason in ['spam', 'abuse', 'personal', 'other']
            && request.resource.data.createdAt == request.time
            && getAfter(post(tid, pid)).data.reportCount == get(post(tid, pid)).data.reportCount + 1;
        }

        match /replies/{rid} {
          allow read: if true;
          allow create: if signedIn() && isMember(tid) && stampedNow(tid) && nameOk(get(member(tid, me())).data.nick)
            && request.resource.data.keys().hasOnly(['authorUid', 'nick', 'text', 'createdAt', 'hidden', 'guest']) && guestFlagOk(tid)
            && request.resource.data.authorUid == me()
            && request.resource.data.nick == get(member(tid, me())).data.nick
            && cleanText(request.resource.data.text, 500)
            && request.resource.data.createdAt == request.time
            && request.resource.data.hidden == false
            && getAfter(post(tid, pid)).data.replyCount == get(post(tid, pid)).data.replyCount + 1;
          allow update: if signedIn() && changedOnly(['hidden']) && request.resource.data.hidden is bool && isCaptain(tid);
          allow delete: if signedIn() && (resource.data.authorUid == me() || lastCaptain(tid));
        }
      }
    }

    // collection-group reads (all my posts / replies across tribes, for data export and account deletion).
    // Posts and replies are public anyway; this only makes the cross-tribe query possible.
    match /{path=**}/posts/{pid} { allow read: if true; }
    match /{path=**}/replies/{rid} { allow read: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
