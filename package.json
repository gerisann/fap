{
  "name": "tribemap",
  "private": true,
  "version": "2.0.0",
  "description": "TribeMap – anonim szurkolói világtérkép. A térképen csak a csapat látszik, név soha.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting:app",
    "sync:profanity": "node scripts/sync-profanity.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project tribemap-app",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tribemap \"node --test tests/rules.test.js\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerisann/fap.git"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "maplibre-gl": "^6.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vite": "^8.3.5"
  }
}
